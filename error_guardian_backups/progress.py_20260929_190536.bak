# ============================================================
# 11. ЗАГРУЗКА
# ============================================================

print("📊 Модуль прогресса загружен (PC)")
print(f"🎨 Стили анимаций: {', '.join(ANIMATION_STYLES.keys())}")
print(f"📁 Temp: {TEMP_DIR}")