# ============================================================
# 2. ФУНКЦИИ
# ============================================================

def get_message(key, **kwargs):
    """
    Получить сообщение по ключу с форматированием.
    
    Args:
        key: ключ из MESSAGES
        **kwargs: параметры для format()
    
    Returns:
        str
    """
    msg = MESSAGES.get(key, MESSAGES.get("unknown", ""))
    
    if not kwargs:
        return msg
    
    try:
        return msg.format(**kwargs)
    except KeyError as e:
        # Не хватает параметра — возвращаем как есть
        print(f"⚠️ Не хватает параметра {e} для '{key}'")
        return msg
    except Exception:
        return msg


def get_random_greeting(chat_type="group"):
    """
    Случайное приветствие.
    
    Args:
        chat_type: "private", "group", "channel"
    
    Returns:
        str
    """
    import random
    
    greetings = {
        "private": [
            "Привет! Я Систмка)",
            "Приветик)",
            "Ну привет) Я Систмка",
        ],
        "group": [
            "Всем привет! Я Систмка)",
            "Привет всем! Я Систмка)",
            "Ну здарова всем) Я Систмка",
        ],
        "channel": [
            "Привет, подписчики! Я Систмка 💜",
            "Всем привет! С вами Систмка 💜",
        ],
    }
    
    return random.choice(
        greetings.get(chat_type, greetings["group"])
    )


def has_message(key):
    """Проверить, есть ли сообщение по ключу"""
    return key in MESSAGES


def get_all_keys():
    """Получить все ключи сообщений"""
    return list(MESSAGES.keys())


def get_messages_count():
    """Получить количество сообщений"""
    return len(MESSAGES)

